# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=voter_db

# Blockchain Configuration (CRITICAL - MUST BE SET!)
GANACHE_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=5242880

# Security (Generate a strong random key for production)
SECRET_KEY=your-secret-key-change-this-in-production

# Admin Credentials (used for server-side admin endpoint protection)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Email Configuration (Optional - for sending voter cards)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com

# AI Configuration (Optional - for enhanced features)
GEMINI_API_KEY=your_gemini_api_key_here
